# تنظیمات سامانه — این فایل را به .env کپی کنید و مقادیر را تغییر دهید
# cp .env.example .env

# نام دیتابیس — هر نامی (حروف انگلیسی/عدد/خط تیره)؛ فایل data/<نام>.db ساخته می‌شود
DB_NAME=tooscable

# مسیر نگهداری داده‌ها (دیتابیس + فایل‌های آپلودشده) — نسبی یا مطلق
DATA_DIR=data

# پورت سرویس
PORT=3000

# پشت nginx مقدار 127.0.0.1 بگذارید؛ برای دسترسی مستقیم در شبکه 0.0.0.0
HOST=0.0.0.0

# --- LiveKit (سرور SFU برای تماس صوتی/تصویری و کنفرانس) ---
# آدرسی که مرورگرِ کاربر با آن به LiveKit وصل می‌شود.
#   توسعه (LiveKit با --dev روی همان دستگاه):  ws://localhost:7880
#   استقرار پشت nginx با TLS:                   wss://automation.tooscore.ir/livekit
LIVEKIT_URL=ws://localhost:7880
# کلید و رمز API — باید با کلیدهای سرور LiveKit یکی باشد.
# در حالت `livekit-server --dev` مقادیر ثابت devkey/secret است (فقط برای تست).
# برای تولید: `livekit-server generate-keys` و همان‌ها را در config.yaml سرور بگذارید.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
